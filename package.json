{
  "name": "rfine",
  "version": "1.3.0",
  "description": "REFINED Media Suite - Offline Desktop Tool",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build:client": "npm run build --prefix client",
    "dist": "npm run build:client && electron-builder"
  },
  "build": {
    "appId": "com.rfine.media",
    "productName": "RFINE",
    "directories": {
      "output": "dist"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Viewer"
      },
      {
        "ext": "png",
        "name": "PNG Image",
        "role": "Viewer"
      },
      {
        "ext": "jpg",
        "name": "JPEG Image",
        "role": "Viewer"
      },
      {
        "ext": "jpeg",
        "name": "JPEG Image",
        "role": "Viewer"
      },
      {
        "ext": "webp",
        "name": "WebP Image",
        "role": "Viewer"
      },
      {
        "ext": "heic",
        "name": "HEIC Image",
        "role": "Viewer"
      },
      {
        "ext": "heif",
        "name": "HEIF Image",
        "role": "Viewer"
      },
      {
        "ext": "mp4",
        "name": "MP4 Video",
        "role": "Viewer"
      },
      {
        "ext": "mkv",
        "name": "MKV Video",
        "role": "Viewer"
      },
      {
        "ext": "mov",
        "name": "MOV Video",
        "role": "Viewer"
      },
      {
        "ext": "webm",
        "name": "WebM Video",
        "role": "Viewer"
      },
      {
        "ext": "avi",
        "name": "AVI Video",
        "role": "Viewer"
      },
      {
        "ext": "mp3",
        "name": "MP3 Audio",
        "role": "Viewer"
      },
      {
        "ext": "wav",
        "name": "WAV Audio",
        "role": "Viewer"
      },
      {
        "ext": "m4a",
        "name": "M4A Audio",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "files": [
      "main.js",
      "server/**/*",
      "client/dist/**/*"
    ],
    "asar": false
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "fluent-ffmpeg": "^2.1.3",
    "heic-convert": "^2.1.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
