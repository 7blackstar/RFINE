{
  "name": "rfine",
  "version": "1.3.4",
  "description": "RFINE Media Suite - Offline Desktop Tool",
  "author": "7blackstar",
  "main": "main.js",
  "type": "commonjs",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "fluent-ffmpeg": "^2.1.3",
    "heic-convert": "^2.1.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "potrace": "^2.1.8",
    "sharp": "^0.33.4"
  },
  "build": {
    "appId": "com.7blackstar.rfine",
    "productName": "RFINE",
    "copyright": "Copyright © 2026 7blackstar",
    "directories": {
      "output": "../../dist-installer"
    },
    "files": [
      "**/*",
      "!**/*.ts",
      "!*.map"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RFINE",
      "runAfterFinish": true,
      "artifactName": "RFINE-Setup-1.3.4.exe"
    },
    "electronVersion": "30.0.0",
    "artifactName": "RFINE-Setup-1.3.4.exe"
  },
  "devDependencies": {
    "electron": "^30.0.0"
  }
}